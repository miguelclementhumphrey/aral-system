# ============================================================================
# ARAL System — Environment Variables
# ============================================================================
# Copy this file to .env and fill in real values.
# DO NOT commit .env files to version control.
# ============================================================================

# --- API Server ---
PORT=8080
MONGODB_URI=mongodb://localhost:27017/aral_system
JWT_SECRET=change_this_to_a_randomly_generated_secret

# --- Frontend ---
FRONTEND_PORT=3000
BASE_PATH=/

# (Optional) Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
