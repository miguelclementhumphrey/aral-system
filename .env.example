# ============================================================================
# ARAL System — Environment Variables
# ============================================================================
# Root reference only.
# The API server reads artifacts/api-server/.env.
# The frontend usually uses shell variables or Vite defaults.
# DO NOT commit .env files to version control.
# ============================================================================

# --- API Server ---
PORT=8080
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/aral_system?retryWrites=true&w=majority
JWT_SECRET=replace_with_at_least_32_random_characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_initial_password
CORS_ORIGIN=http://localhost:3000

# --- Frontend reference ---
# PORT=3000
BASE_PATH=/
API_TARGET=http://localhost:8080

# (Optional) Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
