# ============================================================================
# ARAL System — Environment Variables
# ============================================================================
# Root reference only.
# The API server reads artifacts/api-server/.env.
# The frontend usually uses shell variables or Vite defaults.
# DO NOT commit .env files to version control.
# ============================================================================

# --- API Server ---
PORT=8080
MONGODB_URI=
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_UPDATE_PASSWORD_ON_START=false
SEED_DEMO_DATA=false
DEMO_SCHOOL_PASSWORD=
DEMO_TEACHER_PIN=
CORS_ORIGIN=http://localhost:3000

# --- Frontend reference ---
# PORT=3000
BASE_PATH=/
API_TARGET=http://localhost:8080

# (Optional) Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
